diff --git a/src/util/futex.c b/src/util/futex.c
index df3e949de3d..1c531e5924a 100644
--- a/src/util/futex.c
+++ b/src/util/futex.c
@@ -114,6 +114,127 @@ int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
    return futex(addr, FUTEX_WAIT, value, &tsrel, NULL);
 }
 
+#elif defined(_WIN32) && defined(NVX_XP_FUTEX)
+
+#include <windows.h>
+#include <stdint.h>
+#include <limits.h>
+#include <assert.h>
+#include <errno.h>
+
+/* XP-compatible address wait queues. Waiters remain on their bucket list
+ * until either a wake removes them or a timeout removes them under the same
+ * lock, so a signal cannot target a dead stack waiter. */
+#define NVX_XP_FUTEX_BUCKETS 64
+struct nvx_xp_futex_waiter {
+   uint32_t *addr;
+   HANDLE event;
+   BOOL signaled;
+   struct nvx_xp_futex_waiter *next;
+};
+struct nvx_xp_futex_bucket {
+   CRITICAL_SECTION lock;
+   struct nvx_xp_futex_waiter *waiters;
+};
+static struct nvx_xp_futex_bucket nvx_xp_futex_buckets[NVX_XP_FUTEX_BUCKETS];
+static volatile LONG nvx_xp_futex_init_state;
+
+static void nvx_xp_futex_init(void)
+{
+   LONG state = InterlockedCompareExchange(&nvx_xp_futex_init_state, 1, 0);
+   if (state == 0) {
+      unsigned i;
+      for (i = 0; i < NVX_XP_FUTEX_BUCKETS; i++)
+         InitializeCriticalSection(&nvx_xp_futex_buckets[i].lock);
+      InterlockedExchange(&nvx_xp_futex_init_state, 2);
+   } else {
+      while (InterlockedCompareExchange(&nvx_xp_futex_init_state, 0, 0) != 2)
+         Sleep(0);
+   }
+}
+
+static struct nvx_xp_futex_bucket *nvx_xp_futex_bucket_for(uint32_t *addr)
+{
+   uintptr_t key = (uintptr_t)addr;
+   return &nvx_xp_futex_buckets[(key >> 2) % NVX_XP_FUTEX_BUCKETS];
+}
+
+static DWORD nvx_xp_futex_timeout(const struct timespec *deadline)
+{
+   struct timespec now;
+   int64_t ms;
+   if (!deadline) return INFINITE;
+   timespec_get(&now, TIME_MONOTONIC);
+   ms = ((int64_t)deadline->tv_sec - (int64_t)now.tv_sec) * 1000 +
+        ((int64_t)deadline->tv_nsec - (int64_t)now.tv_nsec) / 1000000;
+   if (ms <= 0) return 0;
+   if (ms >= (int64_t)INFINITE) return INFINITE - 1;
+   return (DWORD)ms;
+}
+
+int futex_wake(uint32_t *addr, int32_t count)
+{
+   struct nvx_xp_futex_bucket *bucket;
+   struct nvx_xp_futex_waiter **link;
+   int woken = 0;
+   assert(count >= 0);
+   nvx_xp_futex_init();
+   bucket = nvx_xp_futex_bucket_for(addr);
+   EnterCriticalSection(&bucket->lock);
+   link = &bucket->waiters;
+   while (*link && woken < count) {
+      struct nvx_xp_futex_waiter *waiter = *link;
+      if (waiter->addr == addr) {
+         *link = waiter->next;
+         waiter->signaled = TRUE;
+         SetEvent(waiter->event);
+         woken++;
+      } else {
+         link = &waiter->next;
+      }
+   }
+   LeaveCriticalSection(&bucket->lock);
+   return woken;
+}
+
+int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
+{
+   struct nvx_xp_futex_bucket *bucket;
+   struct nvx_xp_futex_waiter waiter;
+   struct nvx_xp_futex_waiter **link;
+   DWORD result;
+   int was_signaled;
+   if (InterlockedCompareExchange((volatile LONG *)addr, 0, 0) != value)
+      return EAGAIN;
+   waiter.event = CreateEvent(NULL, TRUE, FALSE, NULL);
+   if (!waiter.event) return -1;
+   waiter.addr = addr;
+   waiter.signaled = FALSE;
+   nvx_xp_futex_init();
+   bucket = nvx_xp_futex_bucket_for(addr);
+   EnterCriticalSection(&bucket->lock);
+   if (InterlockedCompareExchange((volatile LONG *)addr, 0, 0) != value) {
+      LeaveCriticalSection(&bucket->lock);
+      CloseHandle(waiter.event);
+      return EAGAIN;
+   }
+   waiter.next = bucket->waiters;
+   bucket->waiters = &waiter;
+   LeaveCriticalSection(&bucket->lock);
+
+   result = WaitForSingleObject(waiter.event, nvx_xp_futex_timeout(timeout));
+   EnterCriticalSection(&bucket->lock);
+   link = &bucket->waiters;
+   while (*link && *link != &waiter) link = &(*link)->next;
+   if (*link == &waiter) *link = waiter.next;
+   was_signaled = waiter.signaled;
+   LeaveCriticalSection(&bucket->lock);
+   CloseHandle(waiter.event);
+   if (result == WAIT_OBJECT_0 || was_signaled) return 0;
+   if (result == WAIT_TIMEOUT) return ETIMEDOUT;
+   return -1;
+}
+
 #elif defined(_WIN32) && !defined(WINDOWS_NO_FUTEX)
 
 #include <windows.h>
