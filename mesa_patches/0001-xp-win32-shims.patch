diff --git a/src/c11/impl/nvx_win32_xp.h b/src/c11/impl/nvx_win32_xp.h
new file mode 100644
index 00000000000..5ca56f96ba7
--- /dev/null
+++ b/src/c11/impl/nvx_win32_xp.h
@@ -0,0 +1,175 @@
+/* XP compatibility shim for Mesa's Win32 condition-variable users. */
+#ifndef NVX_WIN32_XP_H
+#define NVX_WIN32_XP_H
+
+#include <windows.h>
+#include <limits.h>
+#include <stdlib.h>
+
+typedef struct nvx_xp_condition_state {
+   CRITICAL_SECTION guard;
+   HANDLE semaphore;
+   LONG waiters;
+   LONG wakeups;
+} nvx_xp_condition_state;
+
+static inline nvx_xp_condition_state *
+nvx_xp_condition_get(PCONDITION_VARIABLE cond)
+{
+   return (nvx_xp_condition_state *)cond->Ptr;
+}
+
+static inline BOOL
+nvx_xp_condition_init(PCONDITION_VARIABLE cond)
+{
+   nvx_xp_condition_state *state =
+      (nvx_xp_condition_state *)calloc(1, sizeof(*state));
+   if (!state)
+      return FALSE;
+   InitializeCriticalSection(&state->guard);
+   state->semaphore = CreateSemaphore(NULL, 0, LONG_MAX, NULL);
+   if (!state->semaphore) {
+      DeleteCriticalSection(&state->guard);
+      free(state);
+      return FALSE;
+   }
+   cond->Ptr = state;
+   return TRUE;
+}
+
+static inline void
+nvx_xp_condition_destroy(PCONDITION_VARIABLE cond)
+{
+   nvx_xp_condition_state *state = nvx_xp_condition_get(cond);
+   if (!state)
+      return;
+   CloseHandle(state->semaphore);
+   DeleteCriticalSection(&state->guard);
+   free(state);
+   cond->Ptr = NULL;
+}
+
+static inline void
+nvx_xp_condition_wake(PCONDITION_VARIABLE cond, BOOL broadcast)
+{
+   nvx_xp_condition_state *state = nvx_xp_condition_get(cond);
+   LONG release_count = 0;
+   if (!state)
+      return;
+   EnterCriticalSection(&state->guard);
+   if (broadcast)
+      release_count = state->waiters - state->wakeups;
+   else if (state->waiters > state->wakeups)
+      release_count = 1;
+   if (release_count > 0 &&
+       ReleaseSemaphore(state->semaphore, release_count, NULL))
+      state->wakeups += release_count;
+   LeaveCriticalSection(&state->guard);
+}
+
+static inline BOOL
+nvx_xp_condition_wait(PCONDITION_VARIABLE cond, PCRITICAL_SECTION mutex,
+                      DWORD timeout)
+{
+   nvx_xp_condition_state *state = nvx_xp_condition_get(cond);
+   DWORD result;
+   if (!state)
+      return FALSE;
+   EnterCriticalSection(&state->guard);
+   state->waiters++;
+   LeaveCriticalSection(mutex);
+   LeaveCriticalSection(&state->guard);
+
+   result = WaitForSingleObject(state->semaphore, timeout);
+   EnterCriticalSection(&state->guard);
+   if (result == WAIT_OBJECT_0) {
+      if (state->wakeups > 0)
+         state->wakeups--;
+      state->waiters--;
+   } else {
+      state->waiters--;
+      if (state->wakeups > 0 &&
+          WaitForSingleObject(state->semaphore, 0) == WAIT_OBJECT_0) {
+         if (state->waiters > 0)
+            ReleaseSemaphore(state->semaphore, 1, NULL);
+         else
+            state->wakeups--;
+      }
+   }
+   LeaveCriticalSection(&state->guard);
+   EnterCriticalSection(mutex);
+   return result == WAIT_OBJECT_0;
+}
+
+typedef struct nvx_xp_rwlock_state {
+   CRITICAL_SECTION guard;
+   HANDLE readers_done;
+   HANDLE writers_done;
+   LONG active_readers;
+   LONG waiting_readers;
+   LONG waiting_writers;
+   BOOL writer_active;
+} nvx_xp_rwlock_state;
+
+static inline nvx_xp_rwlock_state *
+nvx_xp_rwlock_get(void **slot)
+{
+   return (nvx_xp_rwlock_state *)*slot;
+}
+
+static inline void
+nvx_xp_rwlock_rdlock(void **slot)
+{
+   nvx_xp_rwlock_state *state = nvx_xp_rwlock_get(slot);
+   EnterCriticalSection(&state->guard);
+   while (state->writer_active || state->waiting_writers > 0) {
+      state->waiting_readers++;
+      LeaveCriticalSection(&state->guard);
+      WaitForSingleObject(state->readers_done, INFINITE);
+      EnterCriticalSection(&state->guard);
+      state->waiting_readers--;
+   }
+   state->active_readers++;
+   LeaveCriticalSection(&state->guard);
+}
+
+static inline void
+nvx_xp_rwlock_rdunlock(void **slot)
+{
+   nvx_xp_rwlock_state *state = nvx_xp_rwlock_get(slot);
+   EnterCriticalSection(&state->guard);
+   if (--state->active_readers == 0 && state->waiting_writers > 0)
+      ReleaseSemaphore(state->writers_done, 1, NULL);
+   LeaveCriticalSection(&state->guard);
+}
+
+static inline void
+nvx_xp_rwlock_wrlock(void **slot)
+{
+   nvx_xp_rwlock_state *state = nvx_xp_rwlock_get(slot);
+   EnterCriticalSection(&state->guard);
+   state->waiting_writers++;
+   while (state->writer_active || state->active_readers > 0) {
+      LeaveCriticalSection(&state->guard);
+      WaitForSingleObject(state->writers_done, INFINITE);
+      EnterCriticalSection(&state->guard);
+   }
+   state->waiting_writers--;
+   state->writer_active = TRUE;
+   LeaveCriticalSection(&state->guard);
+}
+
+static inline void
+nvx_xp_rwlock_wrunlock(void **slot)
+{
+   nvx_xp_rwlock_state *state = nvx_xp_rwlock_get(slot);
+   EnterCriticalSection(&state->guard);
+   state->writer_active = FALSE;
+   if (state->waiting_writers > 0)
+      ReleaseSemaphore(state->writers_done, 1, NULL);
+   else if (state->waiting_readers > 0)
+      ReleaseSemaphore(state->readers_done, state->waiting_readers, NULL);
+   LeaveCriticalSection(&state->guard);
+}
+
+#endif
