diff --git a/src/gallium/frontends/wgl/stw_st.c b/src/gallium/frontends/wgl/stw_st.c
index 717cef04299d..14342d09ff9d 100644
--- a/src/gallium/frontends/wgl/stw_st.c
+++ b/src/gallium/frontends/wgl/stw_st.c
@@ -409,10 +409,16 @@ stw_st_flush(struct st_context *st,
    args.stwfb = stwfb;
    args.flags = flags;
 
-   /* zink presents from its own queue in submission order, so only presents
-    * that read the image on the cpu need the frame to be finished
-    */
-   if (flags & ST_FLUSH_END_OF_FRAME && !stwfb->fb->winsys_framebuffer && !stw_dev->zink)
+   /* CPU-backed WGL presenters must wait before reading the rendered image.
+    * Nouveau's XP path submits asynchronously and currently has no CPU
+    * presenter; waiting here can block SwapBuffers forever on an unsignalled
+    * hardware fence. Keep its submission asynchronous. */
+   const char *driver_name = stw_dev->screen->get_name ?
+      stw_dev->screen->get_name(stw_dev->screen) : NULL;
+   bool nouveau_screen = driver_name && driver_name[0] == 'N' &&
+                        driver_name[1] == 'V';
+   if ((flags & ST_FLUSH_END_OF_FRAME) &&
+       !stwfb->fb->winsys_framebuffer && !stw_dev->zink && !nouveau_screen)
       flags |= ST_FLUSH_WAIT;
 
    if (flags & ST_FLUSH_WAIT)
